### Pruebas de la API - Sistema de Administracion Academica
# URL base de la API (ajustar el puerto si Apache no escucha en 80)
@base = http://localhost:8080/sagrado-corazon/api

### Sprint 1: estado del servicio y conexion unica
GET {{base}}/salud
Accept: application/json

### Ruta inexistente -> 404
GET {{base}}/no-existe
Accept: application/json

### ---------------- AUTENTICACION (Sprint 2) ----------------

### Sin sesion -> 401
GET {{base}}/auth/yo
Accept: application/json

### Credenciales incorrectas -> 400
POST {{base}}/auth/login
Content-Type: application/json

{
  "usuario": "director",
  "clave": "claveIncorrecta"
}

### Login del director -> 200 (guarda la cookie de sesion)
POST {{base}}/auth/login
Content-Type: application/json

{
  "usuario": "director",
  "clave": "Director123*"
}

### Sesion activa -> 200
GET {{base}}/auth/yo
Accept: application/json

### Director en ruta de docente -> 403
GET {{base}}/pruebas/permiso-docente
Accept: application/json

### Cerrar sesion -> 200
POST {{base}}/auth/logout

### ---------------- DOCENTE (Sprint 2 en adelante) ----------------

### Login del docente (docente / Docente123*)
POST {{base}}/auth/login
Content-Type: application/json

{
  "usuario": "docente",
  "clave": "Docente123*"
}

### Docente en ruta de director -> 403
GET {{base}}/pruebas/permiso-director
Accept: application/json

### ---------------- DOCENTE (Sprint 3) ----------------

### Perfil del docente (solo el propio) -> 200
GET {{base}}/docente/perfil
Accept: application/json

### Editar datos de contacto -> 200
PUT {{base}}/docente/perfil
Content-Type: application/json

{
  "nombres": "Carlos",
  "apellidos": "Quispe Rojas",
  "email": "cquispe@sagradocorazon.edu.pe",
  "telefono": "900 222 333",
  "foto": null
}

### Cursos asignados al docente de la sesion -> 200
GET {{base}}/docente/cursos
Accept: application/json

### Horario semanal agrupado por dia -> 200
GET {{base}}/docente/horario
Accept: application/json

### Bandeja de mensajes recibidos -> 200
GET {{base}}/mensajes?carpeta=recibidos
Accept: application/json

### Enviar mensaje a la direccion -> 201
POST {{base}}/mensajes
Content-Type: application/json

{
  "asunto": "Solicitud de material didactico",
  "cuerpo": "Solicito un proyector adicional para el aula de 5to A."
}

### Asunto vacio -> 400
POST {{base}}/mensajes
Content-Type: application/json

{
  "asunto": "",
  "cuerpo": "Mensaje sin asunto"
}