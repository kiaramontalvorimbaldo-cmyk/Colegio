### Pruebas de la API - Sistema de Administracion Academica
# URL base de la API (ajustar el puerto si Apache no escucha en 80)
@base = http://localhost:8080/sagrado-corazon/api

### Sprint 1: estado del servicio y conexion unica
GET {{base}}/salud
Accept: application/json

### Ruta inexistente -> 404
GET {{base}}/no-existe
Accept: application/json

### ---------------- AUTENTICACION (Sprint 2) ----------------

### Sin sesion -> 401
GET {{base}}/auth/yo
Accept: application/json

### Credenciales incorrectas -> 400
POST {{base}}/auth/login
Content-Type: application/json

{
  "usuario": "director",
  "clave": "claveIncorrecta"
}

### Login del director -> 200 (guarda la cookie de sesion)
POST {{base}}/auth/login
Content-Type: application/json

{
  "usuario": "director",
  "clave": "Director123*"
}

### Sesion activa -> 200
GET {{base}}/auth/yo
Accept: application/json

### Director en ruta de docente -> 403
GET {{base}}/pruebas/permiso-docente
Accept: application/json

### Cerrar sesion -> 200
POST {{base}}/auth/logout

### ---------------- DOCENTE (Sprint 2 en adelante) ----------------

### Login del docente (docente / Docente123*)
POST {{base}}/auth/login
Content-Type: application/json

{
  "usuario": "docente",
  "clave": "Docente123*"
}

### Docente en ruta de director -> 403
GET {{base}}/pruebas/permiso-director
Accept: application/json

### ---------------- DOCENTE (Sprint 3) ----------------

### Perfil del docente (solo el propio) -> 200
GET {{base}}/docente/perfil
Accept: application/json

### Editar datos de contacto -> 200
PUT {{base}}/docente/perfil
Content-Type: application/json

{
  "nombres": "Carlos",
  "apellidos": "Quispe Rojas",
  "email": "cquispe@sagradocorazon.edu.pe",
  "telefono": "900 222 333",
  "foto": null
}

### Cursos asignados al docente de la sesion -> 200
GET {{base}}/docente/cursos
Accept: application/json

### Horario semanal agrupado por dia -> 200
GET {{base}}/docente/horario
Accept: application/json

### Bandeja de mensajes recibidos -> 200
GET {{base}}/mensajes?carpeta=recibidos
Accept: application/json

### Enviar mensaje a la direccion -> 201
POST {{base}}/mensajes
Content-Type: application/json

{
  "asunto": "Solicitud de material didactico",
  "cuerpo": "Solicito un proyector adicional para el aula de 5to A."
}

### Asunto vacio -> 400
POST {{base}}/mensajes
Content-Type: application/json

{
  "asunto": "",
  "cuerpo": "Mensaje sin asunto"
}

### ---------------- DOCENTE: ASISTENCIA E INCIDENCIAS (Sprint 4) ----------------

### Lista de estudiantes del curso con su estado del dia -> 200
GET {{base}}/asistencias?curso_id=1&fecha=2026-03-11
Accept: application/json

### Guardado masivo (crea) -> 200
POST {{base}}/asistencias
Content-Type: application/json

{
  "curso_id": 1,
  "fecha": "2026-03-11",
  "registros": [
    { "estudiante_id": 7, "estado": "presente" },
    { "estudiante_id": 8, "estado": "falta" },
    { "estudiante_id": 9, "estado": "tardanza" }
  ]
}

### Re-guardar la misma fecha edita, no duplica (UNIQUE curso+estudiante+fecha) -> 200
POST {{base}}/asistencias
Content-Type: application/json

{
  "curso_id": 1,
  "fecha": "2026-03-11",
  "registros": [
    { "estudiante_id": 8, "estado": "presente" }
  ]
}

### Estado invalido -> 400
POST {{base}}/asistencias
Content-Type: application/json

{
  "curso_id": 1,
  "fecha": "2026-03-11",
  "registros": [ { "estudiante_id": 7, "estado": "volando" } ]
}

### Curso de otro docente -> 403
GET {{base}}/asistencias?curso_id=3&fecha=2026-03-11
Accept: application/json

### Registrar incidencia (nace en estado pendiente) -> 201
POST {{base}}/incidencias
Content-Type: application/json

{
  "estudiante_id": 7,
  "tipo": "conducta",
  "descripcion": "Uso reiterado del celular durante la clase de programacion.",
  "fecha": "2026-04-14"
}

### Incidencias del docente, con filtro por estado -> 200
GET {{base}}/incidencias?estado=pendiente
Accept: application/json

### Reporte consolidado del docente -> 200
GET {{base}}/docente/reportes
Accept: application/json

### ---------------- DIRECCION (Sprint 5) ----------------

### Indicadores del panel -> 200
GET {{base}}/director/resumen
Accept: application/json

### Incidencias de toda la institucion (el docente solo ve las suyas) -> 200
GET {{base}}/incidencias?estado=pendiente
Accept: application/json

### Resolver incidencia con respuesta -> 200
PUT {{base}}/incidencias/6
Content-Type: application/json

{
  "estado": "resuelta",
  "respuesta_director": "Se notifico al tutor del aula y se acordo un seguimiento con la familia."
}

### Alta de docente: devuelve usuario y contrasena (se muestra una sola vez) -> 201
POST {{base}}/docentes
Content-Type: application/json

{
  "nombres": "Rosa",
  "apellidos": "Alvarado Medina",
  "dni": "70551234",
  "especialidad": "Matematicas",
  "email": "ralvarado@sagradocorazon.edu.pe",
  "telefono": "900555666",
  "sueldo": 1550
}

### Evaluaciones + promedios por docente -> 200
GET {{base}}/evaluaciones
Accept: application/json

### Registrar evaluacion -> 201
POST {{base}}/evaluaciones
Content-Type: application/json

{
  "docente_id": 1,
  "puntaje": 4,
  "observaciones": "Buen manejo del aula y cumplimiento de la programacion.",
  "fecha": "2026-04-20"
}

### Puntaje fuera de rango -> 400
POST {{base}}/evaluaciones
Content-Type: application/json

{
  "docente_id": 1,
  "puntaje": 9,
  "observaciones": "Puntaje fuera del rango permitido"
}

### Crear curso -> 201
POST {{base}}/cursos
Content-Type: application/json

{
  "nombre": "Ciencia y Ambiente",
  "grado": "5to",
  "seccion": "A",
  "periodo": "2026-1",
  "docente_id": 3
}

### Curso duplicado (UNIQUE nombre+grado+seccion+periodo) -> 400
POST {{base}}/cursos
Content-Type: application/json

{
  "nombre": "Matematica",
  "grado": "6to",
  "seccion": "A",
  "periodo": "2026-1",
  "docente_id": 2
}

### Horario valido -> 201
POST {{base}}/horarios
Content-Type: application/json

{
  "curso_id": 1,
  "dia": 5,
  "hora_inicio": "07:00",
  "hora_fin": "08:30",
  "aula": "Lab-Computo"
}

### Cruce del mismo docente en el mismo dia -> 400
POST {{base}}/horarios
Content-Type: application/json

{
  "curso_id": 1,
  "dia": 1,
  "hora_inicio": "07:45",
  "hora_fin": "09:15",
  "aula": "A-201"
}

### Cruce por aula ocupada (docente distinto) -> 400
POST {{base}}/horarios
Content-Type: application/json

{
  "curso_id": 3,
  "dia": 1,
  "hora_inicio": "07:30",
  "hora_fin": "09:00",
  "aula": "A-201"
}

### Eliminar horario -> 200
DELETE {{base}}/horarios/11

### ---------------- DIRECCION: UGEL, PLANTILLAS Y ECONOMIA (Sprint 6) ----------------

### Contactos de la UGEL -> 200
GET {{base}}/ugel/contactos
Accept: application/json

### Mensaje del director a un docente -> 201
POST {{base}}/mensajes
Content-Type: application/json

{
  "tipo_destino": "usuario",
  "destinatario_id": 3,
  "asunto": "Felicitacion por su evaluacion",
  "cuerpo": "Su manejo de Lengua y Comunicacion fue destacado durante este bimestre."
}

### Mensaje del director a la UGEL -> 201
POST {{base}}/mensajes
Content-Type: application/json

{
  "tipo_destino": "ugel",
  "destinatario_ugel_id": 1,
  "asunto": "Informe academico 2026-1",
  "cuerpo": "Adjuntamos el informe de gestion academica del periodo 2026-1."
}

### Bandeja completa (recibidos y enviados) -> 200
GET {{base}}/mensajes?carpeta=todos
Accept: application/json

### Plantillas UGEL disponibles -> 200
GET {{base}}/plantillas
Accept: application/json

### Documento generado con los datos institucionales ya puestos -> 200
GET {{base}}/plantillas/1/generar
Accept: application/json

### Indicadores economicos -> 200
GET {{base}}/economia/resumen
Accept: application/json

### Cambiar pension, estudiantes y gastos: recalcula todo -> 200
PUT {{base}}/economia/parametros
Content-Type: application/json

{
  "pension_mensual": 420,
  "num_estudiantes": 32,
  "gastos_operativos": 5000,
  "meses": 5
}

### Meses fuera de rango -> 400
PUT {{base}}/economia/parametros
Content-Type: application/json

{
  "meses": 15
}